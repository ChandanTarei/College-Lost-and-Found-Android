<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Requests"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#283593"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvRequestsItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvRequestsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading requests..."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:id="@+id/requestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnBackRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
