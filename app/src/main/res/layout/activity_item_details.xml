<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#283593"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/ivDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#E8EAF6"
            android:scaleType="fitCenter"
            android:contentDescription="Item photo"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNoPhoto"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="No photo available"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Item Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#283593" />

        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Type:"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvDetailCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Category:"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Location:"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvDetailDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Date:"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Description:"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status:"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#F57C00" />

        <TextView
            android:id="@+id/tvContactRequestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#283593"
            android:textSize="15sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Number shown only after contact approval -->
        <TextView
            android:id="@+id/tvApprovedContactNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="16dp"
            android:background="@drawable/bg_lf_input"
            android:text="Owner's Contact Number"
            android:textColor="#202A44"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRequestContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Request Contact"
            android:textAllCaps="false"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnManageRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Manage Contact Requests"
            android:textAllCaps="false"
            android:backgroundTint="#5E35B1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBackDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Back to Items"
            android:textAllCaps="false"
            android:backgroundTint="#3949AB"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
